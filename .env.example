GARMIN_EMAIL="twoj_email@example.com"
GARMIN_PASSWORD="twoje_haslo"
# Opcjonalny token sesji w formacie base64 (np. z ~/.garminconnect/garmin_tokens.json) - zalecany w CI/CD (GitHub Secrets)
# Wygeneruj komendą: base64 -w 0 ~/.garminconnect/garmin_tokens.json
# GARMIN_TOKENS_BASE64="ey..."

# Klucz Gemini API (wymagany)
GEMINI_API_KEY="twoj_klucz_gemini_api"
# Model Gemini (domyślnie gemini-3.8-flash z automatyczną pętlą retry co 10s)
GEMINI_MODELS="gemini-3.8-flash"

# Konfiguracja powiadomień Telegram (opcjonalne, do wysyłki raportu na telefon)
TELEGRAM_BOT_TOKEN="twoj_token_z_botfather"
TELEGRAM_CHAT_ID="twoj_chat_id_z_userinfobot"
